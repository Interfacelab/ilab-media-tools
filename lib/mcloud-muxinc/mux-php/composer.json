{
    "name": "mcloud-muxinc/mux-php",
    "version": "3.16.0",
    "description": "Mux is how developers build online video. This API encompasses both Mux Video and Mux Data functionality to help you build your video-related projects better and faster than ever before.",
    "keywords": [
        "php",
        "sdk",
        "rest",
        "api",
        "video",
        "streaming"
    ],
    "homepage": "https://mux.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Mux SDK Team",
            "homepage": "https://mux.com",
            "email": "sdks@mux.com"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "mcloud-guzzlehttp/guzzle": "7.8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "MediaCloud\\Vendor\\MuxPhp\\": "MuxPhp/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MuxPhp\\Test\\": "test/"
        }
    }
}